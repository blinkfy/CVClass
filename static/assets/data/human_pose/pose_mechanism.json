{
  "pageStatus": "预设样例 · 机制拆解",
  "sampleId": "pose_sample_01",
  "deeppose": {
    "label": "DeepPose 坐标回归",
    "summary": "用 CNN 直接回归人体关键点坐标向量，再把归一化坐标映射回原图坐标。",
    "steps": [
      {
        "id": "crop",
        "label": "人体裁剪",
        "input": "原图 + 人体检测框 bbox",
        "output": "人体区域 crop",
        "formula": "crop = image[bbox_y : bbox_y + bbox_h, bbox_x : bbox_x + bbox_w]",
        "note": "检测框把人体从复杂背景中裁出，后续网络只看人体区域。"
      },
      {
        "id": "feature",
        "label": "CNN 特征提取",
        "input": "人体 crop 图像",
        "output": "深度特征向量",
        "formula": "f = CNN(crop)",
        "note": "卷积网络把纹理、边缘和身体结构聚合成紧凑特征。"
      },
      {
        "id": "regress",
        "label": "姿态向量回归",
        "input": "特征向量",
        "output": "归一化姿态向量",
        "formula": "p_norm = W f + b",
        "note": "回归头一次性输出所有关节点的归一化坐标。"
      },
      {
        "id": "absolute",
        "label": "原图坐标映射",
        "input": "归一化姿态向量 + bbox",
        "output": "原图关键点坐标",
        "formula": "x = bbox_x + normalized_x * bbox_w; y = bbox_y + normalized_y * bbox_h",
        "note": "归一化坐标需要映射回原图坐标，才能绘制关键点和骨架。"
      },
      {
        "id": "refine",
        "label": "姿态精修",
        "input": "初始关键点",
        "output": "精修骨架",
        "formula": "p_t = refine(p_{t-1}, image_feature)",
        "note": "多阶段修正会利用图像上下文修正偏移明显的关节点。"
      }
    ],
    "normalizedPoints": [
      {"id": 0, "name": "nose", "nx": 0.414, "ny": 0.126},
      {"id": 5, "name": "left_shoulder", "nx": 0.621, "ny": 0.258},
      {"id": 6, "name": "right_shoulder", "nx": 0.207, "ny": 0.255},
      {"id": 11, "name": "left_hip", "nx": 0.571, "ny": 0.566},
      {"id": 12, "name": "right_hip", "nx": 0.293, "ny": 0.570}
    ]
  },
  "heatmap": {
    "label": "Heatmap 峰值定位",
    "summary": "网络为每个关节点输出一张空间热力图，在每张 heatmap 上寻找峰值作为关键点位置。",
    "steps": [
      {
        "id": "image",
        "label": "输入图像",
        "input": "原图或人体 crop",
        "output": "网络输入张量",
        "formula": "I ∈ R^{H × W × 3}",
        "note": "输入保留空间布局，为后续 heatmap 预测提供定位基础。"
      },
      {
        "id": "feature_map",
        "label": "空间特征图",
        "input": "图像张量",
        "output": "空间特征图",
        "formula": "F = Backbone(I)",
        "note": "特征图保留低分辨率空间结构，编码身体部位响应。"
      },
      {
        "id": "heatmaps",
        "label": "关节点热力图",
        "input": "特征图",
        "output": "K 张关节点 heatmap",
        "formula": "H_k = Conv_k(F)",
        "note": "每个关节点都有独立响应图，亮点表示该关节点更可能出现的位置。"
      },
      {
        "id": "peak",
        "label": "峰值检测",
        "input": "关节点 heatmap",
        "output": "峰值坐标",
        "formula": "joint_k = argmax Heatmap_k(x, y)",
        "note": "对每张 heatmap 取最大响应位置，得到关节点坐标。"
      },
      {
        "id": "skeleton",
        "label": "骨架组装",
        "input": "解码后的关键点",
        "output": "人体骨架图",
        "formula": "limb_ij = connect(joint_i, joint_j)",
        "note": "按 COCO 骨架模板连接关键点，形成可解释的人体结构。"
      }
    ],
    "heatmaps": [
      {"id": 0, "name": "nose", "x": 394, "y": 160, "score": 0.96, "color": "#f59e0b"},
      {"id": 5, "name": "left_shoulder", "x": 423, "y": 200, "score": 0.94, "color": "#2563eb"},
      {"id": 6, "name": "right_shoulder", "x": 365, "y": 199, "score": 0.94, "color": "#2563eb"},
      {"id": 9, "name": "left_wrist", "x": 459, "y": 290, "score": 0.64, "color": "#12b5d0"},
      {"id": 10, "name": "right_wrist", "x": 339, "y": 292, "score": 0.58, "color": "#12b5d0"},
      {"id": 15, "name": "left_ankle", "x": 421, "y": 407, "score": 0.79, "color": "#64748b"}
    ]
  }
}
